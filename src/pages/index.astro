---
import Layout from '../layouts/Layout.astro';

// --- ESTRUCTURAS DE DATOS Y DOMINIO ---
interface ServiceItem {
  title: string;
  iconSvg: string;
  features: string[];
  ctaText: string;
  ctaAnchor: string;
}

interface CertItem {
  title: string;
  iconColor: string;
  bgColor: string;
  colSpan?: string;
