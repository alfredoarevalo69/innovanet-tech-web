const CASE_STUDIES: CaseStudy[] = [
  {
    tag: 'SecOps & Endpoint Security',
    title: 'Blindaje ASR en +500 Dispositivos',
    description: 'Despliegue de políticas avanzadas de Attack Surface Reduction (ASR) y afinamiento en Defender para entidad pública. Visibilidad total de amenazas y reducción del 5% en falsos positivos.'
  },
  {
    tag: 'Identity & Cloud Security',
    title: 'Gobierno PIM & Automatización Entra ID',
    description: 'Implementación de acceso Just-In-Time (PIM) en entorno Multitenant bancario y automatización con PowerShell, reduciendo el tiempo de aprovisionamiento en un 50%.'
  },
  {
    tag: 'Vulnerability Management',
    title: 'Remediación Crítica Qualys / CVE',
