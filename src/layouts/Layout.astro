---
import Navbar from '../components/Navbar.astro';
import LegalNavbar from '../components/LegalNavbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  variant?: 'home' | 'legal';
}

const { 
  title, 
  description = "Ingeniería de Infraestructura y Seguridad IT. Evaluaciones sin costo ni compromiso.", 
  variant = 'home' 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://sysarmortech.com');
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} | SysArmor Tech</title>
    
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
  </head>
  
  <!-- 
    Layout neutro sin azules. 
    bg-[#020617] es el color base global.
    selection:bg-slate-500/30 asegura que al seleccionar texto sea neutro.
  -->
  <body class="bg-[#020617] text-white selection:bg-slate-500/30">
    
    {variant === 'home' ? <Navbar /> : <LegalNavbar />}
    
    <main class="bg-[#020617] min-h-screen">
      <slot />
    </main>
    
    <Footer />
  </body>
</html>