---
// src/layouts/Layout.astro
import Navbar from '../components/Navbar.astro';
import LegalNavbar from '../components/LegalNavbar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  variant?: 'home' | 'legal';
}

const { 
  title, 
  description = "Ingeniería de Infraestructura y Seguridad IT. Evaluaciones sin costo ni compromiso.", 
  variant = 'home' 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://sysarmortech.com');

// Datos estructurados Schema.org optimizados para autoridad de marca y alcance regional
const schemaOrgData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "SysArmor Tech",
  "alternateName": "SysArmorTech",
  "url": "https://sysarmortech.com",
  "logo": "https://sysarmortech.com/favicon.png",
  "image": "https://sysarmortech.com/favicon.png",
  "description": description,
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": "Bogotá, Colombia"
  },
  "serviceType": [
    "Infraestructura IT",
    "SecOps",
    "Active Directory",
    "Windows Server",
    "Hardening"
  ],
  "priceRange": "$$$"
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon optimizado apuntando directamente al nuevo PNG -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    
    <title>{title} | SysArmor Tech</title>
    
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="https://sysarmortech.com/favicon.png" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgData)} />
  </head>
  
  <body class="bg-[#020617] text-white selection:bg-slate-500/30">
    
    {variant === 'home' ? <Navbar /> : <LegalNavbar />}
    
    <main class="bg-[#020617] min-h-screen">
      <slot />
    </main>
    
    <Footer />
    
    <!-- Componente de analíticas para registrar el tráfico en Vercel -->
    <Analytics />
  </body>
</html>