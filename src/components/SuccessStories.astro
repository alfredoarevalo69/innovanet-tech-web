---
// src/components/SuccessStories.astro

// Datos centralizados para mantenimiento escalable
const successStories = [
  {
    category: "SECOPS & ENDPOINT SECURITY",
    title: "Blindaje ASR en +500 Dispositivos",
    description: "Despliegue de políticas avanzadas de Attack Surface Reduction (ASR) y afinamiento en Defender para entidad pública. Reducción drástica de la superficie de ataque y contención inmediata de vectores de riesgo."
  },
  {
    category: "IDENTITY & CLOUD SECURITY",
    title: "Gobierno PIM & Automatización Entra ID",
    description: "Implementación de acceso Just-In-Time (PIM) en entorno Multitenant bancario y automatización con PowerShell, reduciendo el tiempo de aprovisionamiento en un 50%."
  },
  {
    category: "VULNERABILITY MANAGEMENT",
    title: "Remediación Crítica Qualys / CVE",
    description: "Liderazgo del ciclo de remediación sobre parques de +200 servidores Windows. Hardening de llaves de registro, parcheo complejo y mitigación sin afectación operativa."
  }
];
---

<!-- scroll-mt-24 previene que el nav fijo oculte el título -->
<section id="casos-de-exito" class="py-20 bg-slate-100 border-t border-slate-200 px-4 scroll-mt-24">
  <div class="max-w-6xl mx-auto space-y-12">
    
    <!-- Título de Sección -->
    <div class="text-center space-y-2">
      <h2 class="text-3xl font-display font-bold text-neutral-900 uppercase tracking-wide">Casos de Éxito Destacados</h2>
      <p class="text-slate-700 font-medium text-base">Proyectos reales con impacto medible en seguridad y operación.</p>
    </div>

    <!-- Grid de Casos -->
    <div class="grid md:grid-cols-3 gap-8">
      {successStories.map((story) => (
        <div class="bg-white p-8 rounded-xl border border-slate-300 shadow-md hover:shadow-lg transition-all duration-300">
          <h4 class="text-xs font-bold text-blue-600 tracking-wider uppercase mb-2">
            {story.category}
          </h4>
          <h3 class="text-xl font-display font-bold text-neutral-900 mb-4">
            {story.title}
          </h3>
          <p class="text-slate-700 text-sm leading-relaxed font-sans font-normal">
            {story.description}
          </p>
        </div>
      ))}
    </div>
    
  </div>
</section>