// src/components/Navbar.astro
---

<nav class="py-6 px-6 border-b border-slate-700/50 flex items-center justify-between bg-[#0a1628]">
  <!-- Logo y Marca -->
  <a href="/" class="flex items-center gap-3">
    <img src="/images/logo.png" alt="SysArmor Tech Logo" class="h-10 w-auto" />
    <span class="text-xl font-bold tracking-tight text-white">
      SYSARMOR <span class="text-blue-500">TECH</span>
    </span>
  </a>

  <!-- Menú de Navegación Completo -->
  <div class="hidden md:flex items-center gap-6 text-slate-300 font-medium">
    <a href="/#servicios" class="hover:text-white transition-colors">Servicios</a>
    <a href="/#enfoque-tecnico" class="hover:text-white transition-colors">Enfoque Técnico</a>
    <a href="/#casos-de-exito" class="hover:text-white transition-colors">Casos de Éxito</a>
    <a href="/#faq" class="hover:text-white transition-colors">FAQ</a>
    <a href="/#contacto" class="hover:text-white transition-colors">Contacto</a>
