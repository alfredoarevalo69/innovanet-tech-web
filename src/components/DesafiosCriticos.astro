---
// src/components/DesafiosCriticos.astro
const desafios = [
  {
    title: "Sistemas Legados",
    desc: "Plataformas fuera de soporte (EOL) que comprometen la estabilidad y abren vectores de ataque innecesarios."
  },
  {
    title: "Brechas de Seguridad",
    desc: "Falta de una estrategia de hardening (ASR/Defender) que deja su data expuesta a riesgos críticos."
  },
  {
    title: "Ineficiencia Operativa",
    desc: "Procesos manuales, alertas falsas y gestión de identidades desordenada que drenan su presupuesto de TI."
  },
  {
    title: "Falta de Compliance",
    desc: "Ausencia de gobernanza bajo estándares ISO 27001 que impide acceder a sectores de alta regulación."
  }
];
---

<section class="py-20 bg-slate-50 px-6">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold text-slate-900 mb-4 text-center">¿Su infraestructura está limitando su crecimiento?</h2>
    <p class="text-center text-slate-600 mb-12">Si su equipo enfrenta estos escenarios, necesita una intervención de Nivel 3.</p>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {desafios.map(item => (
        <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-200 hover:shadow-md transition-shadow">
          <h3 class="text-lg font-bold text-blue-600 mb-3">{item.title}</h3>
          <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>