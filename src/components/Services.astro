---
// src/components/Services.astro

const services = [
  {
    title: "Auditoría & Hardening",
    icon: "🛡️",
    items: ["Análisis de Vulnerabilidades", "Hardening de M365", "ASR y PIM"],
    cta: "Solicitar Auditoría"
  },
  {
    title: "Soporte Nivel 3",
    icon: "⚙️",
    items: ["Administración Avanzada", "Automatización PowerShell", "Respaldo Recuperación"],
    cta: "Diagnosticar N3"
  },
  {
    title: "Migración a la Nube",
    icon: "☁️",
    items: ["M365 & Azure", "Migración Servidores", "Backup en la Nube"],
    cta: "Planear Migración"
  }
];
---

<section id="servicios" class="py-16 bg-slate-100 border-t border-slate-200 px-4">
  <div class="max-w-6xl mx-auto space-y-12">
    <h2 class="text-3xl font-display font-bold text-center text-neutral-900 pb-2">
      NUESTROS SERVICIOS
    </h2>
    
    <div class="grid md:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
          
          <div>
            <!-- Header de tarjeta -->
            <div class="bg-neutral-900 text-white p-6 text-center">
              <h3 class="text-xl font-display font-bold mb-2">{service.title}</h3>
              <div class="text-3xl">{service.icon}</div>
            </div>
            
            <!-- Cuerpo de tarjeta -->
            <div class="p-6 space-y-4">
              <ul class="space-y-3 text-neutral-700">
                {service.items.map((item) => (
                  <li class="flex items-center gap-2 font-sans">
                    <span class="text-green-600 font-bold">✓</span> {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          
          <!-- Botón de Acción (CTA) en Azul para contraste -->
          <div class="p-6 pt-0">
            <a href="#contacto" 
               class="block w-full bg-blue-600 hover:bg-blue-700 text-white text-center py-3 rounded-lg font-bold transition-all duration-300 shadow-sm">
              {service.cta}
            </a>
          </div>

        </div>
      ))}
    </div>
  </div>
</section>