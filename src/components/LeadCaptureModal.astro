---
// src/components/LeadCaptureModal.astro
---

<div class="w-full">
  <!-- Encabezado -->
  <div class="text-center md:text-left mb-6">
    <h3 class="text-2xl font-bold text-white mb-2">Solicitar Recurso Técnico</h3>
    <p class="text-slate-400 text-sm">
      Ingresa tus datos para acceder de forma inmediata a la guía PDF y a la batería de scripts de PowerShell.
    </p>
  </div>

  <!-- Mensaje de Confirmación con Descarga Directa -->
  <div id="success-message" class="hidden bg-slate-800/90 border border-[#D4AF37]/50 rounded-xl p-6 text-center space-y-4 shadow-xl">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-500/20 text-green-500 mb-2">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h4 class="text-lg font-bold text-white">¡Solicitud Procesada con Éxito!</h4>
    <p class="text-slate-300 text-sm leading-relaxed">
      Tus datos han sido registrados correctamente. Ya puedes descargar tu recurso técnico a continuación:
    </p>
    
    <!-- Botón de Descarga Directa (Ruta corregida con el nombre exacto y mayúsculas) -->
    <div class="pt-2">
      <a 
        id="btn-descarga-directa"
        href="/Guia_Migracion_Server_2025.pdf" 
        download="Guia_Migracion_Server_2025.pdf"
        class="inline-flex items-center justify-center gap-2 w-full py-3 px-6 bg-[#D4AF37] hover:bg-white text-[#020617] font-bold rounded-lg transition-all duration-200 shadow-[0_0_15px_rgba(212,175,55,0.2)] hover:shadow-[0_0_20px_rgba(255,255,255,0.3)]"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        Descargar Guía y Scripts Ahora
      </a>
    </div>
  </div>

  <!-- Formulario de Captura -->
  <form id="lead-capture-form" class="space-y-4">
    <div>
      <label for="fullName" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
        Nombre Completo *
      </label>
      <input 
        type="text" 
        id="fullName" 
        name="fullName" 
        required 
        placeholder="Ej. Carlos Pérez" 
        class="w-full bg-slate-800/80 border border-slate-700/80 rounded-lg px-4 py-3 text-slate-100 text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all placeholder:text-slate-500"
      />
    </div>

    <div>
      <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
        Correo Corporativo *
      </label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        required 
        placeholder="carlos@empresa.com" 
        class="w-full bg-slate-800/80 border border-slate-700/80 rounded-lg px-4 py-3 text-slate-100 text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all placeholder:text-slate-500"
      />
    </div>

    <div>
      <label for="company" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
        Empresa / Organización <span class="text-slate-500 font-normal">(Opcional)</span>
      </label>
      <input 
        type="text" 
        id="company" 
        name="company" 
        placeholder="Ej. SysArmor Tech" 
        class="w-full bg-slate-800/80 border border-slate-700/80 rounded-lg px-4 py-3 text-slate-100 text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all placeholder:text-slate-500"
      />
    </div>

    <!-- Checkbox Legal -->
    <div class="flex items-center gap-2 pt-1">
      <input 
        type="checkbox" 
        id="aceptaOfertas" 
        name="aceptaOfertas"
        required
        class="w-4 h-4 rounded bg-slate-800 border-slate-700 text-[#D4AF37] focus:ring-[#D4AF37]"
      />
      <label for="aceptaOfertas" class="text-xs text-slate-400 select-none">
        Acepto recibir recursos técnicos y comunicaciones de SysArmor Tech.
      </label>
    </div>

    <button 
      type="submit" 
      id="submit-btn"
      class="w-full py-3.5 px-6 bg-[#D4AF37] hover:bg-white text-[#020617] font-bold rounded-lg transition-all duration-200 shadow-[0_0_15px_rgba(212,175,55,0.2)] hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] flex items-center justify-center gap-2"
    >
      <span id="btn-text">Obtener Recurso Ahora</span>
      <svg id="btn-spinner" class="hidden animate-spin h-5 w-5 text-[#020617]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </button>
  </form>
</div>

<script>
  const form = document.getElementById('lead-capture-form') as HTMLFormElement;
  const successMessage = document.getElementById('success-message');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn && btnText && btnSpinner) {
      submitBtn.disabled = true;
      btnText.textContent = 'Procesando...';
      btnSpinner.classList.remove('hidden');
    }

    const formData = new FormData(form);
    const dataPayload = {
      nombre: formData.get('fullName'),
      correo: formData.get('email'),
      empresa: formData.get('company') || 'N/A',
      aceptaOfertas: (document.getElementById('aceptaOfertas') as HTMLInputElement)?.checked
    };

    try {
      const response = await fetch("/api/send-lead", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(dataPayload)
      });

      if (response.ok) {
        form.classList.add('hidden');
        successMessage?.classList.remove('hidden');
      } else {
        alert("Ocurrió un error. Por favor intenta de nuevo.");
        resetButton();
      }
    } catch (error) {
      alert("Error de conexión.");
      resetButton();
    }
  });

  function resetButton() {
    if (submitBtn && btnText && btnSpinner) {
      submitBtn.disabled = false;
      btnText.textContent = 'Obtener Recurso Ahora';
      btnSpinner.classList.add('hidden');
    }
  }
</script>