---
// src/components/LeadCaptureModal.astro
---

<div class="space-y-6">
  <div>
    <h3 class="text-xl font-bold text-white mb-2">Descarga la Guía Técnica PDF</h3>
    <p class="text-slate-300 text-sm">
      Completa tus datos para recibir el acceso directo al documento y recursos de automatización.
    </p>
  </div>

  <form id="lead-form" class="space-y-4">
    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Nombre Completo</label>
      <input 
        type="text" 
        name="nombre"
        required 
        placeholder="Ej. Carlos Mendoza" 
        class="w-full px-4 py-3 bg-slate-950/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all"
      />
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Correo Electrónico Profesional</label>
      <input 
        type="email" 
        name="correo"
        required 
        placeholder="carlos@tuempresa.com" 
        class="w-full px-4 py-3 bg-slate-950/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all"
      />
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Empresa / Organización</label>
      <input 
        type="text" 
        name="empresa"
        required 
        placeholder="Ej. SysArmor Tech" 
        class="w-full px-4 py-3 bg-slate-950/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all"
      />
    </div>

    <div class="flex items-start gap-2 pt-1">
      <input 
        type="checkbox" 
        id="consent" 
        name="aceptaOfertas"
        required 
        class="mt-1 rounded border-slate-700 bg-slate-950 text-[#D4AF37] focus:ring-[#D4AF37] focus:ring-offset-slate-900"
      />
      <label for="consent" class="text-xs text-slate-400 leading-relaxed">
        Acepto recibir la guía técnica y comunicaciones de ingeniería de SysArmor Tech.
      </label>
    </div>

    <button 
      type="submit" 
      id="submit-btn"
      class="w-full py-3.5 px-4 bg-[#D4AF37] hover:bg-white text-slate-950 font-bold text-sm rounded-xl transition-all shadow-lg flex items-center justify-center gap-2 mt-2 cursor-pointer"
    >
      <span id="btn-text">Acceder a la Guía PDF</span>
      <svg id="btn-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </button>
  </form>

  <div id="download-section" class="hidden pt-4 border-t border-slate-800 text-center space-y-3">
    <p class="text-xs text-emerald-400 font-medium">¡Datos registrados y verificados con éxito!</p>
    <a 
      href="/Guia_Migracion_Server_2025.pdf" 
      download="Guia_Migracion_Server_2025.pdf"
      id="download-btn"
      class="inline-flex items-center justify-center w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm rounded-xl transition-all gap-2 shadow-lg cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
      <span>Descargar PDF Ahora</span>
    </a>
  </div>

  <p class="text-[11px] text-center text-slate-500">
    Tus datos están protegidos. Cero spam, solo contenido técnico de valor.
  </p>
</div>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement;
  const downloadSection = document.getElementById('download-section');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');

  const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyEpHpTu-pR_zeP7emUlxokosRotexwBMl09q1nRdQmu2pjUUGYj_pi_QP4E6I_Ql94/exec';

  if (form && downloadSection) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (submitBtn && btnText && btnSpinner) {
        submitBtn.disabled = true;
        btnText.textContent = 'Procesando...';
        btnSpinner.classList.remove('hidden');
      }

      const formData = new FormData(form);
      const params = new URLSearchParams({
        fecha: new Date().toLocaleString(),
        nombre: formData.get('nombre')?.toString() || '',
        correo: formData.get('correo')?.toString() || '',
        empresa: formData.get('empresa')?.toString() || '',
        aceptaOfertas: formData.get('aceptaOfertas') ? 'SÍ' : 'NO'
      });

      try {
        await fetch(`${GOOGLE_SCRIPT_URL}?${params.toString()}`, {
          method: 'GET',
          mode: 'no-cors'
        });
      } catch (error) {
        console.error('Error al registrar lead:', error);
      }

      form.style.display = 'none';
      downloadSection.classList.remove('hidden');
    });
  }
</script>