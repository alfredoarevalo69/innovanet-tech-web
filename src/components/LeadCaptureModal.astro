---
// src/components/LeadCaptureModal.astro
---

<div class="space-y-6">
  <div>
    <h3 class="text-xl font-bold text-white mb-2">Descarga la Guía Técnica PDF</h3>
    <p class="text-slate-300 text-sm">
      Completa tus datos para recibir el acceso directo al documento y recursos de automatización.
    </p>
  </div>

  <form id="lead-form" class="space-y-4">
    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Nombre Completo</label>
      <input 
        type="text" 
        required 
        placeholder="Ej. Carlos Mendoza" 
        class="w-full px-4 py-3 bg-slate-950/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all"
      />
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Correo Electrónico Profesional</label>
      <input 
        type="email" 
        required 
        placeholder="carlos@tuempresa.com" 
        class="w-full px-4 py-3 bg-slate-950/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all"
      />
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Empresa / Organización</label>
      <input 
        type="text" 
        required 
        placeholder="Ej. SysArmor Tech" 
        class="w-full px-4 py-3 bg-slate-950/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all"
      />
    </div>

    <div class="flex items-start gap-2 pt-1">
      <input 
        type="checkbox" 
        id="consent" 
        required 
        class="mt-1 rounded border-slate-700 bg-slate-950 text-[#D4AF37] focus:ring-[#D4AF37] focus:ring-offset-slate-900"
      />
      <label for="consent" class="text-xs text-slate-400 leading-relaxed">
        Acepto recibir la guía técnica y comunicaciones de ingeniería de SysArmor Tech.
      </label>
    </div>

    <button 
      type="submit" 
      class="w-full py-3.5 px-4 bg-[#D4AF37] hover:bg-white text-slate-950 font-bold text-sm rounded-xl transition-all shadow-lg flex items-center justify-center gap-2 mt-2"
    >
      <span>Acceder a la Guía PDF</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </button>
  </form>

  <!-- Sección de descarga con redirección automática al home/hero -->
  <div id="download-section" class="hidden pt-4 border-t border-slate-800 text-center space-y-3">
    <p class="text-xs text-emerald-400 font-medium">¡Datos verificados con éxito!</p>
    <button 
      type="button" 
      id="download-btn"
      class="inline-flex items-center justify-center w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm rounded-xl transition-all gap-2 shadow-lg cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
      <span>Descargar PDF y Volver al Inicio</span>
    </button>
  </div>

  <p class="text-[11px] text-center text-slate-500">
    Tus datos están protegidos. Cero spam, solo contenido técnico de valor.
  </p>
</div>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement;
  const downloadSection = document.getElementById('download-section');
  const downloadBtn = document.getElementById('download-btn');

  if (form && downloadSection && downloadBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.style.display = 'none';
      downloadSection.classList.remove('hidden');
    });

    // Dispara la descarga del PDF y redirige al inicio (/) tras un breve retraso
    downloadBtn.addEventListener('click', () => {
      const pdfUrl = '/Guia_Migracion_Server_2025.pdf';
      const fileName = 'Guia_Migracion_Server_2025.pdf';

      const a = document.createElement('a');
      a.href = pdfUrl;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);

      // Redirige a la página principal después de iniciar la descarga
      setTimeout(() => {
        window.location.href = '/';
      }, 800);
    });
  }
</script>