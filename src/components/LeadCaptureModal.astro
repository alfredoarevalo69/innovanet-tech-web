---
// src/components/LeadCaptureModal.astro
---

<div id="lead-form-container" class="w-full">
  <div class="mb-6 text-center lg:text-left">
    <h3 class="text-xl font-bold text-white mb-2">Descarga la Guía Técnica PDF</h3>
    <p class="text-sm text-slate-300">Completa tus datos para recibir el acceso directo al documento y recursos de automatización.</p>
  </div>

  <form id="leadCaptureForm" class="space-y-4">
    <div>
      <label for="fullName" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Nombre Completo</label>
      <input 
        type="text" 
        id="fullName" 
        name="fullName" 
        required
        placeholder="Ej. Carlos Mendoza" 
        class="w-full px-4 py-2.5 bg-slate-950/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all text-sm"
      />
    </div>

    <div>
      <label for="workEmail" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Correo Electrónico Profesional</label>
      <input 
        type="email" 
        id="workEmail" 
        name="workEmail" 
        required
        placeholder="carlos@tuempresa.com" 
        class="w-full px-4 py-2.5 bg-slate-950/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all text-sm"
      />
    </div>

    <div>
      <label for="company" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Empresa / Organización</label>
      <input 
        type="text" 
        id="company" 
        name="company" 
        required
        placeholder="Ej. SysArmor Tech" 
        class="w-full px-4 py-2.5 bg-slate-950/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] transition-all text-sm"
      />
    </div>

    <div class="pt-2">
      <button 
        type="submit" 
        id="submitBtn"
        class="w-full py-3 px-4 bg-[#D4AF37] hover:bg-[#e6c158] text-slate-950 font-bold text-sm rounded-xl transition-all shadow-lg flex items-center justify-center gap-2 group cursor-pointer"
      >
        <span id="btnText">Acceder a la Guía PDF</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>

    <p class="text-[11px] text-slate-400 text-center mt-3">
      Tus datos están protegidos. Cero spam, solo contenido técnico de valor.
    </p>
  </form>

  <!-- Estado de Éxito Oculto (Se muestra al enviar) -->
  <div id="successMessage" class="hidden text-center py-8 space-y-4">
    <div class="w-12 h-12 bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 rounded-full flex items-center justify-center mx-auto text-xl">
      ✓
    </div>
    <h4 class="text-lg font-bold text-white">¡Registro Exitoso!</h4>
    <p class="text-sm text-slate-300">Hemos enviado el enlace de descarga directo a tu correo electrónico.</p>
  </div>
</div>

<script>
  const form = document.getElementById('leadCaptureForm') as HTMLFormElement;
  const successMessage = document.getElementById('successMessage');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const btnText = document.getElementById('btnText');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (submitBtn && btnText) {
        submitBtn.disabled = true;
        btnText.textContent = 'Procesando...';
      }

      // Simulación de envío o lógica de integración (Ajustar según backend / API)
      setTimeout(() => {
        form.style.display = 'none';
        if (successMessage) {
          successMessage.classList.remove('hidden');
        }
      }, 1000);
    });
  }
</script>