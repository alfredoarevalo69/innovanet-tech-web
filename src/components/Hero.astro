---
// src/components/Hero.astro
---

<section class="relative w-full min-h-[600px] py-12 md:py-0 flex items-center justify-center overflow-hidden">
    
    <!-- IMAGEN DE FONDO CON FOCO ADAPTABLE Y PRIORIZACIÓN DE CARGA -->
    <img 
        src="/images/hero-datacenter.webp" 
        alt="SysArmor Tech Datacenter" 
        class="absolute inset-0 w-full h-full object-cover object-[75%_center] md:object-center"
        loading="eager"
        fetchpriority="high"
    />

    <!-- OVERLAY OSCURO -->
    <div class="absolute inset-0 bg-brand-dark/75 z-10"></div>

    <!-- CONTENIDO -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 w-full">
        <div class="max-w-3xl space-y-6">
            
            <!-- TÍTULO -->
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tighter leading-tight text-white">
                <span class="block animate-fade-up opacity-0">
                    Infraestructura Crítica <span class="text-brand-accent">Blindada</span>
                </span>
            </h1>

            <!-- PÁRRAFO (Texto del Ingeniero) -->
            <p class="text-base sm:text-lg md:text-xl text-slate-200 animate-fade-up delay-200 opacity-0 leading-relaxed">
                Ingeniero Senior (+20 años) especializado en la modernización de entornos híbridos, 
                remediación de sistemas legados y aseguramiento de operaciones bajo estándares 
                <span class="text-brand-gold font-bold"> ISO 27001</span>. Garantizo resiliencia técnica y continuidad operativa.
            </p>

            <!-- CTA Y PROPUESTA DE VALOR -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-6 pt-2 sm:pt-4 animate-fade-up delay-400 opacity-0">
                <a href="/#contacto" class="px-8 py-4 rounded-lg bg-brand-gold text-brand-dark font-bold text-lg hover:bg-white transition-all shadow-lg hover:shadow-brand-gold/20 text-center whitespace-nowrap">
                    Solicitar Evaluación Técnica
                </a>
                
                <!-- Puntos de valor -->
                <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 text-white font-medium text-sm md:text-base">
                    <span class="flex items-center gap-2">
                        <span class="text-brand-accent font-bold">✓</span> Aceleración de Migraciones
                    </span>
                    <span class="flex items-center gap-2">
                        <span class="text-brand-accent font-bold">✓</span> Hardening ISO 27001
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>