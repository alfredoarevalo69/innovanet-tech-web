---
// src/components/Hero.astro
---
<section class="relative py-24 px-6 text-center bg-[#0a1628] overflow-hidden">
  
  <!-- Imagen de fondo vinculada -->
  <div class="absolute inset-0 z-0 opacity-20">
    <img src="/images/hero-datacenter.webp" alt="Infraestructura Crítica" class="w-full h-full object-cover" />
  </div>

  <div class="relative z-10 max-w-4xl mx-auto space-y-6">
    <h1 class="text-5xl md:text-6xl font-bold text-white tracking-tight">
      Infraestructura Crítica <span class="text-blue-500">Blindada</span>
    </h1>
    <p class="text-xl text-slate-200 max-w-2xl mx-auto leading-relaxed">
      Ingeniero Senior (+20 años) especializado en la modernización de entornos híbridos, 
      remediación de sistemas legados y aseguramiento de operaciones bajo estándares 
      <strong class="text-white">ISO 27001</strong>. Garantizo resiliencia técnica y continuidad operativa.
    </p>
    <div class="pt-8 flex flex-col md:flex-row gap-4 justify-center items-center">
      <a href="#contacto" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-lg font-bold transition-all">
        Solicitar Evaluación Técnica
      </a>
      <span class="text-slate-300 font-medium">✓ Aceleración de Migraciones</span>
      <span class="text-slate-300 font-medium">✓ Hardening ISO 27001</span>
    </div>
  </div>
</section>