---
// src/components/Contact.astro
---
<section id="contacto" class="py-20 px-6 bg-[#020617]">
  <!-- Contenedor principal con gris neutro profundo -->
  <div class="max-w-2xl mx-auto bg-[#0a0a0a] border border-[#262626] rounded-2xl p-8 shadow-xl">
    
    <h2 class="text-3xl font-bold text-white text-center mb-2">Solicita tu Evaluación</h2>
    <p class="text-neutral-400 text-center mb-8">Analizamos tu infraestructura sin costo ni compromiso.</p>

    <!-- Botones de Acción -->
    <div class="grid md:grid-cols-2 gap-4">
      
      <!-- Botón Primario: Correo -->
      <a href="mailto:contacto@sysarmortech.com" 
         class="flex items-center justify-center gap-3 bg-[#D4AF37] hover:bg-[#b8962d] text-[#020617] font-bold py-3 px-4 rounded-lg transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        Enviar por Correo
      </a>

      <!-- Botón Secundario: Gmail Web -->
      <a href="https://mail.google.com/mail/?view=cm&fs=1&to=contacto@sysarmortech.com" target="_blank" rel="noopener noreferrer"
         class="flex items-center justify-center gap-3 bg-[#171717] hover:bg-[#262626] border border-[#333333] text-white font-medium py-3 px-4 rounded-lg transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" viewBox="0 0 24 24" fill="currentColor">
          <path d="M24 4.5v15c0 1.38-1.12 2.5-2.5 2.5H2.5C1.12 22 0 20.88 0 19.5v-15C0 3.12 1.12 2 2.5 2h19C22.88 2 24 3.12 24 4.5zM22 6.5l-10 6.25L2 6.5v13l9 0 0-7.25 1 0 0 7.25 9 0v-13z"/>
        </svg>
        Gmail Web
      </a>
    </div>

    <!-- Botón WhatsApp -->
    <div class="mt-4">
      <a href="https://wa.me/tu_numero" target="_blank" rel="noopener noreferrer"
         class="flex items-center justify-center gap-3 bg-[#171717] hover:bg-[#262626] border border-[#333333] text-white font-medium py-3 px-4 rounded-lg transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
        WhatsApp
      </a>
    </div>
    
    <!-- Texto inferior -->
    <p class="text-center text-neutral-500 text-sm mt-8">
      O escribe directo a: <a href="mailto:contacto@sysarmortech.com" class="text-neutral-300 hover:text-[#D4AF37] transition-colors underline">contacto@sysarmortech.com</a>
    </p>
  </div>
</section>