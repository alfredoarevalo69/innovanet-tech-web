---
// src/components/Contact.astro
// Configuración del número de WhatsApp para Bogotá, Colombia (+57)
const whatsappNumber = "573126030958"; 
const whatsappMessage = encodeURIComponent("Hola, me gustaría solicitar una Evaluación Técnica de mi infraestructura.");
---
<section id="contacto" class="py-20 px-6 bg-[#020617]">
  <!-- Contenedor principal con gris neutro profundo -->
  <div class="max-w-2xl mx-auto bg-[#0a0a0a] border border-[#262626] rounded-2xl p-8 shadow-xl">
    
    <h2 class="text-3xl font-bold text-white text-center mb-2">Solicita tu Evaluación</h2>
    <p class="text-neutral-400 text-center mb-8">Analizamos tu infraestructura sin costo ni compromiso.</p>

    <!-- Botones de Acción -->
    <div class="grid md:grid-cols-2 gap-4">
      
      <!-- Botón Primario: Correo predeterminado -->
      <a href="mailto:contacto@sysarmortech.com?subject=Solicitud%20de%20Evaluaci%C3%B3n%20T%C3%A9cnica" 
         class="flex items-center justify-center gap-3 bg-[#D4AF37] hover:bg-[#b8962d] text-[#020617] font-bold py-3 px-4 rounded-lg transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Enviar por Correo
      </a>

      <!-- Botón Secundario: Gmail Web -->
      <a href="https://mail.google.com/mail/?view=cm&fs=1&to=contacto@sysarmortech.com&su=Solicitud%20de%20Evaluacion%20Tecnica" 
         target="_blank" 
         rel="noopener noreferrer"
         class="flex items-center justify-center gap-3 bg-[#171717] hover:bg-[#262626] border border-[#333333] text-white font-medium py-3 px-4 rounded-lg transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
        Gmail Web
      </a>
    </div>

    <!-- Botón WhatsApp -->
    <div class="mt-4">
      <a href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`} 
         target="_blank" 
         rel="noopener noreferrer"
         class="flex items-center justify-center gap-3 bg-[#171717] hover:bg-[#262626] border border-[#333333] text-white font-medium py-3 px-4 rounded-lg transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.764.459 3.483 1.333 5.001L2 22l5.127-1.34c1.464.798 3.113 1.218 4.882 1.218h.004c5.503 0 9.987-4.478 9.988-9.985 0-2.667-1.037-5.175-2.923-7.062C17.19 2.946 14.68 2 12.012 2zM12.013 20.165h-.003c-1.503 0-2.977-.404-4.263-1.168l-.305-.181-3.167.828.844-3.088-.198-.316c-.84-1.336-1.284-2.883-1.284-4.473.001-4.502 3.666-8.163 8.172-8.163 2.181 0 4.232.85 5.773 2.392 1.542 1.542 2.39 3.593 2.389 5.774-.002 4.503-3.667 8.165-8.17 8.175z"/>
        </svg>
        WhatsApp
      </a>
    </div>
    
    <!-- Texto inferior -->
    <p class="text-center text-neutral-500 text-sm mt-8">
      O escribe directo a: <a href="mailto:contacto@sysarmortech.com" class="text-neutral-300 hover:text-[#D4AF37] transition-colors underline">contacto@sysarmortech.com</a>
    </p>
  </div>
</section>