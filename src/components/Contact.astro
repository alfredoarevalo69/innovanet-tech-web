---
// src/components/Contacto.astro
---

<section id="contacto" class="py-16 px-6 bg-[#0a1628]">
  <div class="max-w-lg mx-auto bg-slate-900/40 border border-slate-800 p-8 md:p-10 rounded-3xl shadow-2xl backdrop-blur-sm">
    
    <!-- Título y Subtítulo -->
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold text-white mb-3 tracking-tight">Solicita tu Evaluación</h2>
      <p class="text-slate-400">Analizamos tu infraestructura sin costo ni compromiso.</p>
    </div>

    <!-- Contenedor de Botones -->
    <div class="flex flex-col gap-4">
      
      <!-- Botón 1: Correo -->
      <a href="mailto:contacto@sysarmortech.com" class="flex items-center justify-center gap-3 w-full py-4 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-xl transition-all duration-300 hover:scale-[1.02] shadow-lg shadow-blue-900/20">
        <span>📧 Enviar por Correo</span>
      </a>

      <!-- Botón 2: Gmail Web -->
      <a href="https://mail.google.com/mail/?view=cm&fs=1&to=contacto@sysarmortech.com" target="_blank" class="flex items-center justify-center gap-3 w-full py-4 bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white font-semibold rounded-xl transition-all duration-300 hover:scale-[1.02]">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.818V11.73l-6.546 4.545-6.546-4.545v9.272H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-1.202 1.458-1.884 2.426-1.127l9.574 6.649 9.574-6.649c.968-.757 2.426-.075 2.426 1.127z"/>
        </svg>
        <span>Abrir en Gmail Web</span>
      </a>

      <!-- Botón 3: WhatsApp -->
      <a href="https://wa.me/TU_NUMERO_AQUI" target="_blank" class="flex items-center justify-center gap-3 w-full py-4 bg-green-600 hover:bg-green-500 text-white font-semibold rounded-xl transition-all duration-300 hover:scale-[1.02] shadow-lg shadow-green-900/20">
        <span>💬 WhatsApp</span>
      </a>
    </div>

    <!-- Pie de página -->
    <p class="mt-8 text-center text-sm text-slate-500">
      Correo directo: <a href="mailto:contacto@sysarmortech.com" class="hover:text-blue-400 underline decoration-slate-600">contacto@sysarmortech.com</a>
    </p>
  </div>
</section>